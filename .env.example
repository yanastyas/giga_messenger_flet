# ===== Подключение к PostgreSQL (Yandex Cloud) =====
DB_HOST=your-host.mdb.yandexcloud.net
DB_PORT=6432
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password
DB_SSLMODE=verify-full

# ===== Настройки приложения =====
APP_TITLE=GigaMessenger
SERVER_PORT=8888
WINDOW_WIDTH=400
WINDOW_HEIGHT=700